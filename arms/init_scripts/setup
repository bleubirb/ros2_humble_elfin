#!/bin/bash

set -ex

cd "$(dirname "$(readlink -f "$0")")"

if sudo tmux ls ; then
    echo "Already running setup scripts in sudo tmux sessions."
    exit 0
fi

setup_1_log="setup_1.log"
setup_1_str="Successful 'activate' of hardware 'GazeboSystem'"

sudo rm -f $setup_1_log
sudo tmux new -d "./setup_1 $setup_1_log"

while ! grep -q "$setup_1_str" $setup_1_log; do
    echo "Waiting for setup_1 to finish..."
    sleep 2
done

echo "setup_1 finished successfully."

setup_2_log="setup_2.log"
setup_2_str="Ready to take commands for planning group elfin_arm."

sudo rm -f $setup_2_log
sudo tmux new -d "./setup_2 $setup_2_log"

while ! grep -q "$setup_2_str" $setup_2_log; do
    echo "Waiting for setup_2 to finish..."
    sleep 2
done

echo "setup_2 finished successfully."

setup_3_log="setup_3.log"
setup_3_str="Listening to '/planning_scene'"

sudo rm -f $setup_3_log
sudo tmux new -d "./setup_3 $setup_3_log"

while ! grep -q "$setup_3_str" $setup_3_log; do
    echo "Waiting for setup_3 to finish..."
    sleep 2
done

echo "setup_3 finished successfully."

setup_4_log="setup_4.log"
setup_4_str="process started with pid"

sudo rm -f $setup_4_log
sudo tmux new -d "./setup_4 $setup_4_log"

while ! grep -q "$setup_4_str" $setup_4_log; do
    echo "Waiting for setup_4 to finish..."
    sleep 2
done

echo "setup_4 finished successfully."
